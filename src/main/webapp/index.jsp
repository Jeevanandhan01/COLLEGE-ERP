<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>College ERP - Knowledge Institute of Technology</title>
    <link rel="stylesheet" href="./styles/dashboard.css">
</head>
<body>

<nav class="navbar">
    <ul class="nav-links">
        <li><a href="login.jsp">Login</a></li>
        <li><a href="#admin">Admin</a></li>
        <li><a href="#faculty">Faculty</a></li>
        <li><a href="#students">Students</a></li>
        <li><a href="#bus">Transport</a></li>
        <li><a href="#placement">Placements</a></li>
        <li><a href="#exam">Examinations</a></li>
        <li><a href="#clubs">Clubs & Events</a></li>
        <li><a href="#reports">Reports</a></li>
    </ul>
</nav>

<header class="hero-section">
    <h1>Welcome to Knowledge Institute of Technology</h1>
    <p>Empowering Students with Technology & Innovation</p>
</header>

<section id="dashboard" class="dashboard-section">
    <h2>College ERP Dashboard</h2>
    <div class="stats">
        <div class="card">Total Students: <span>1200</span></div>
        <div class="card">Total Faculty: <span>150</span></div>
        <div class="card">Departments: <span>10</span></div>
        <div class="card">Buses Available: <span>15</span></div>
        <div class="card">Placement Rate: <span>85%</span></div>
    </div>
</section>

<section id="admin" class="admin-section">
    <center>
    <h2>Admin Panel</h2>
    <p>Manage Faculty, Student Data, and Infrastructure.</p>
    </center>
</section>

<section id="faculty" class="faculty-section">
    <h2>Faculty Information</h2>
    <ul>
        <li>Faculty Name</li>
        <li>Department</li>
        <li>Designation</li>
        <li>Mentor Details</li>
        <li>Placement Officer: <span>Yes/No</span></li>
    </ul>
</section>

<section id="students" class="students-section">
    <h2>Student Information</h2>
    <ul>
        <li>Personal Information</li>
        <li>Financial Information</li>
        <li>Academic Details</li>
        <li>Placement Status</li>
        <li>Scholarship & Fees</li>
    </ul>
</section>

<section id="bus" class="bus-section">
    <h2>Transport Management</h2>
    <ul>
        <li>Bus ID</li>
        <li>Route Information</li>
        <li>Driver Contact</li>
        <li>Maintenance Status</li>
        <li>Fare Information</li>
    </ul>
</section>

<section id="placement" class="placement-section">
    <h2>Placement & Training</h2>
    <ul>
        <li>Company Details</li>
        <li>Job Profiles</li>
        <li>Recruitment Process</li>
        <li>Training Programs</li>
        <li>Annual Placement Rate</li>
    </ul>
</section>

<section id="exam" class="exam-section">
    <h2>Examinations</h2>
    <ul>
        <li>Exam Timetable</li>
        <li>Seating Arrangement</li>
        <li>Results Processing</li>
        <li>Revaluation Requests</li>
        <li>Exam Performance Reports</li>
    </ul>
</section>

<section id="clubs" class="clubs-section">
    <h2>Clubs & Forums</h2>
    <ul>
        <li>Club Name</li>
        <li>Event Details</li>
        <li>Club Incharge</li>
        <li>Resource Person</li>
    </ul>
</section>

<section id="reports" class="reports-section">
    <h2>Reports & Analytics</h2>
    <ul>
        <li>Placement Report</li>
        <li>Academic Performance</li>
        <li>Attendance Reports</li>
        <li>Financial Reports</li>
        <li>Student Discipline Records</li>
    </ul>
</section>

<footer class="footer">
    <p>&copy; 2025 Knowledge Institute of Technology. All rights reserved.</p>
</footer>

</body>
</html>
